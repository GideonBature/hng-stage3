# Slack incoming webhook URL used by the detector to send ban/unban/global alerts.
# Create one at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Public IP of the VPS that hosts Nextcloud (used as a Nextcloud trusted domain).
SERVER_IP=your.server.ip.address

# Public domain (or subdomain) that points to this server and serves the detector dashboard.
# Example: detector.example.com or my-detector.duckdns.org
DASHBOARD_DOMAIN=your.dashboard.domain

# Docker bridge gateway IP that the nginx container uses to reach the detector
# (the detector container runs with network_mode: host, so nginx must reach it via the host).
# On most default Docker setups this is 172.17.0.1; on user-defined bridges it may be 172.18.0.1, 172.19.0.1, etc.
# Find it with: docker network inspect <network> | grep Gateway
DOCKER_GATEWAY_IP=172.17.0.1
